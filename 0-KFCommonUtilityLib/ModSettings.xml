<?xml version="1.0" encoding="utf-8"?>
<ModSettings version="2">
  <Global>
    <Tab name="RecoilSettings" displayKey="kflibTabRecoilSettingsName" tooltipKey="">
      <Category name="Capping" displayKey="kflibCategoryRecoilCappingName" tooltipKey="">
        <Slider name="RecoilCompensationSensitivityMultiplier" displayKey="kflibSettingRecoilCSMName" defaultValue="0.00" type="float">
          <Description key="kflibSettingRecoilCSMDesc" />
          <Incremental increment="0.01" minValue="0" maxValue="1" />
          <Formatter ui="0.00" />
        </Slider>
        <Switch name="EnablePreRecoilCompensation" displayKey="kflibSettingEnablePreRecoilCompensationName" defaultValue="Disable" type="string">
          <Description key="kflibSettingEnablePreRecoilCompensationDesc" />
          <Buttons left="Disable" right="Enable" />
        </Switch>
        <Switch name="EnableCap" displayKey="kflibSettingEnableCapName" defaultValue="Disable" type="string">
          <Description key="kflibSettingEnableCapDesc" />
          <Buttons left="Disable" right="Enable" />
        </Switch>
        <Slider name="RecoilRemain" displayKey="kflibSettingRecoilRemainName" defaultValue="0.2" type="float">
          <Description key="kflibSettingRecoilRemainDesc" />
          <Incremental increment="0.01" minValue="0" maxValue="1" />
          <Formatter ui="0.00" />
        </Slider>
        <Switch name="EnableSoftCap" displayKey="kflibSettingEnableSoftCapName" defaultValue="Disable" type="string">
          <Description key="kflibSettingEnableSoftCapDesc" />
          <Buttons left="Disable" right="Enable" />
        </Switch>
        <Slider name="MaxRecoilAngle" displayKey="kflibSettingMaxRecoilAngleName" defaultValue="15" type="int">
          <Description key="kflibSettingMaxRecoilAngleDesc" />
          <Incremental increment="1" minValue="0" maxValue="45" />
        </Slider>
        <Switch name="EnableDynamicCap" displayKey="kflibSettingEnableDynamicCapName" defaultValue="Disable" type="string">
          <Description key="kflibSettingEnableDynamicCapDesc" />
          <Buttons left="Disable" right="Enable" />
        </Switch>
        <Slider name="MaxDynamicRecoilCapShots" displayKey="kflibSettingMaxDynamicRecoilCapShotsName" defaultValue="6" type="int">
          <Description key="kflibSettingMaxDynamicRecoilCapShotsDesc" />
          <Incremental increment="1" minValue="0" maxValue="30" />
        </Slider>
      </Category>
    </Tab>
    <Tab name="CameraAnimationSettings" displayKey="kflibTabCameraAnimationSettingsName" tooltipKey="">
      <Category name="Default" displayKey="kflibCategoryCAIDefaultSettingsName" tooltipKey="">
        <Slider name="CameraAnimationIntensityMultiplier" displayKey="kflibSettingCAIMultiplierName" defaultValue="1.00" type="float">
          <Description key="kflibSettingCAIMultiplierDesc" />
          <Incremental increment="0.01" minValue="0" maxValue="1" />
          <Formatter ui="0.00" />
        </Slider>
      </Category>
    </Tab>
    <Tab name="MiscSettings" displayKey="kflibTabMiscSettingsName" tooltipKey="">
      <Category name="AutoInspect" displayKey="kflibCategoryAutoInspect" tooltipKey="">
        <Switch name="EnableAutoInspect" displayKey="kflibSettingEnableAutoInspectName" defaultValue="Enabled" type="string">
          <Description key="kflibSettingEnableAutoInspectDesc" />
          <Buttons left="Disabled" right="Enabled" />
        </Switch>
        <Slider name="AutoInspectInterval" displayKey="kflibSettingAutoInspectIntervalName" defaultValue="60" type="float">
          <Description key="kflibSettingAutoInspectIntervalDesc" />
          <Incremental increment="1" minValue="30" maxValue="60" />
          <Formatter ui="0" />
        </Slider>
      </Category>
      <Category name="AimCorrection" displayKey="kflibCategoryAimCorrection" tooltipKey="">
        <Selector name="AimCorrectionType" displayKey="kflibSettingsAimCorrectionTypeName" defaultValue="Both" type="string">
          <Description key="kflibSettingsAimCorrectionTypeDesc" />
          <List allowedValues="None,FovByDistance,MixedOrtho,Both" />
        </Selector>
      </Category>
      <Category name="PiPCamera" displayKey="kflibCategoryPiPCamera" tooltipKey="">
        <Selector name="SyncAAQuality" displayKey="kflibSettingSyncAAQualityName" defaultValue="Disabled" type="string">
          <Description key="kflibSettingSyncAAQualityDesc" />
          <List allowedValues="Disabled,Antialiasing" />
        </Selector>
      </Category>
      <Category name="VerboseLog" displayKey="kflibCategoryVerboseLog" tooltipKey="kflibCategoryVerboseLogDesc">
        <Switch name="KFModuleManagerLog" displayKey="kflibSettingModuleManagerLogName" defaultValue="Disabled" type="string">
          <Description key="kflibSettingModuleManagerLogDesc" />
          <Buttons left="Disabled" right="Enabled" />
        </Switch>
      </Category>
    </Tab>
  </Global>
  <World />
</ModSettings>
